# Generated by Cargo
/target/
**/*.rs.bk
*.pdb

# Local editor and IDE files
.vscode/
.idea/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db
ehthumbs.db

# OpenCode & local agent artifacts
.opencode/plans/
.opencode/tool-output/
.freebuff/
*.log

# Local test media (never commit user media files)
/media/
*.mp4
# The website demo is the one video tracked on purpose (free-licence wallpapers, ~3 MB).
!site/media/demo.mp4
*.mov
*.mkv
*.webm

# Environment and credentials
.env
.env.*
!.env.example

# Local packaging output (installer/zip builds)
/dist/
# Python bytecode from asset scripts
__pycache__/
